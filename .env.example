# Copy to .env and fill in. .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=sk-ant-...

# Model + cost controls (Module 2 decision: Sonnet 5 to stay under $5 total)
CTI_MODEL=claude-sonnet-5
CTI_EFFORT_ROUTING=low
CTI_EFFORT_EXTRACTION=medium
CTI_EFFORT_REASONING=high

# Validation layer (ASSUMPTION A-01 — calibrated in Module 13, not derived)
CTI_CONFIDENCE_THRESHOLD=0.6

# PubMed asks for an email for rate-limit courtesy
PUBMED_CONTACT_EMAIL=
